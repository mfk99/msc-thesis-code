# Makefile for C++ with Microsoft cl compiler

CXX = cl
CXXFLAGS = /nologo /W3 /EHsc
LDFLAGS =

TARGET = program.exe
OBJ_DIR = build
SRCS = index.cpp settings\settings.cpp semantics/scheduling-semantics.cpp
OBJS = $(OBJ_DIR)\settings.obj $(OBJ_DIR)\scheduling-semantics.obj $(OBJ_DIR)\index.obj

# Default rule
all: $(TARGET)

# Link step
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) $(LDFLAGS) /Fe$(TARGET)

# Ensure build directory exists
!if !exist($(OBJ_DIR))
!message Creating $(OBJ_DIR) directory
!endif

# Per-file compile rules
$(OBJ_DIR)\index.obj: index.cpp
	if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) /c index.cpp /Fo$@

$(OBJ_DIR)\settings.obj: settings\settings.cpp
	if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) /c settings\settings.cpp /Fo$@

$(OBJ_DIR)\scheduling-semantics.obj: semantics\scheduling-semantics.cpp
	if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) /c semantics\scheduling-semantics.cpp /Fo$@

# Clean rule
clean:
	if exist $(OBJ_DIR) del /Q $(OBJ_DIR)\*.obj
	if exist $(TARGET) del /Q $(TARGET)